# =============================================================================
# VaxAssist AI - Backend Environment Configuration Template
# =============================================================================

# Application Settings
PROJECT_NAME="VaxAssist AI"
API_V1_STR="/api/v1"
ENVIRONMENT="production"      # Use "development" locally, "production" on Railway
DEBUG=False                   # Set to False in production

# Server & Network Binding
# In production containers (Railway), HOST must be 0.0.0.0.
# Railway automatically assigns PORT via environment variable.
HOST="0.0.0.0"
PORT=8000

# CORS - Comma-separated list or JSON array of allowed frontend origins.
# Note: Any *.vercel.app deployment is also automatically supported by CORS regex.
# Add your custom production frontend domain(s) here:
BACKEND_CORS_ORIGINS=["https://vaxassist-ai.vercel.app","http://localhost:5173","http://127.0.0.1:5173"]

# MongoDB Configuration
# Local: mongodb://localhost:27017
# Production Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="vaxassist_db"
MONGODB_SERVER_SELECTION_TIMEOUT_MS=15000

# Security & JWT Authentication (Phase 2)
# Generate a secure 32+ character random string in production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY="your-super-secret-key-change-this-in-production-min-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Bootstrap (Phase 2)
# Configures the initial system admin if no admin exists in the database
ADMIN_EMAIL="admin@vaxassist.ai"
ADMIN_PASSWORD="ChangeThisAdminPass2026!"
ADMIN_NAME="System Administrator"
AUTO_BOOTSTRAP_ADMIN=True

# AI / LLM Configuration (Phase 7 & 8)
LLM_PROVIDER="gemini"
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
OPENAI_API_KEY=""
GEMINI_EMBEDDING_MODEL="models/gemini-embedding-2"
GEMINI_GENERATION_MODEL="models/gemini-flash-latest"

# Knowledge Base & Persistent Storage (Phase 7 RAG & Vector Store)
# On Railway, create a Volume mounted at /app/data and use persistent volume paths:
# CHROMA_PERSIST_DIRECTORY="/app/data/chroma"
# KNOWLEDGE_STORAGE_DIRECTORY="/app/data/knowledge"
CHROMA_PERSIST_DIRECTORY="data/chroma"
KNOWLEDGE_STORAGE_DIRECTORY="data/knowledge"
CHROMA_COLLECTION_NAME="vaxassist_knowledge"
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=150
RAG_TOP_K=4

# Monitoring & Background Engine (Phase 6)
MONITORING_INTERVAL_MINUTES=60
ENABLE_BACKGROUND_SCHEDULER=True

# Transactional Notifications (Brevo Email & SMS API)
BREVO_API_KEY=""
BREVO_SENDER_NAME="VaxAssist AI"
BREVO_SENDER_EMAIL="notifications@vaxassist.ai"
BREVO_SMS_SENDER_NAME="VaxAssist"
BREVO_EMAIL_TEMPLATE_ID=
BREVO_EMAIL_ENABLED=True
BREVO_SMS_ENABLED=True

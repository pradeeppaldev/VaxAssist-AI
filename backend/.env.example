# Application Settings
PROJECT_NAME="VaxAssist AI"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Server
HOST="127.0.0.1"
PORT=8000

# CORS - Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# MongoDB Configuration
# Local: mongodb://localhost:27017 or Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="vaxassist_db"

# Security & JWT Authentication (Phase 2)
JWT_SECRET_KEY="your-super-secret-key-change-this-in-production-min-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Bootstrap (Phase 2)
# Configures the initial system admin if no admin exists in the database
ADMIN_EMAIL="admin@vaxassist.ai"
ADMIN_PASSWORD="ChangeThisAdminPass2026!"
ADMIN_NAME="System Administrator"
AUTO_BOOTSTRAP_ADMIN=True

# AI / LLM Configuration (Phase 7 & 8)
LLM_PROVIDER="gemini"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
GEMINI_EMBEDDING_MODEL="models/gemini-embedding-2"
GEMINI_GENERATION_MODEL="models/gemini-flash-latest"

# Knowledge Base & ChromaDB Vector Store
CHROMA_PERSIST_DIRECTORY="data/chroma"
KNOWLEDGE_STORAGE_DIRECTORY="data/knowledge"
CHROMA_COLLECTION_NAME="vaxassist_knowledge"

# Brevo Transactional Email & SMS Notifications
BREVO_API_KEY=""
BREVO_SENDER_NAME="VaxAssist AI"
BREVO_SENDER_EMAIL="notifications@vaxassist.ai"
BREVO_SMS_SENDER_NAME="VaxAssist"
BREVO_EMAIL_TEMPLATE_ID=
BREVO_EMAIL_ENABLED=True
BREVO_SMS_ENABLED=True
